    "expo",
    "@batch.com/expo-plugin",
    "BatchExpoPlugin"
  ],
  "bugs": {
    "url": "https://github.com/BatchLabs/Batch-Expo-Plugin/issues"
  },
  "author": "Batch.com (https://github.com/BatchLabs)",
  "license": "MIT",
  "homepage": "https://github.com/BatchLabs/Batch-Expo-Plugin#readme",
  "dependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expo": "^54.0.18",
    "expo-module-scripts": "^5.0.7",
    "prettier": "^3.6.2",
    "react-native": "0.81.5"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
