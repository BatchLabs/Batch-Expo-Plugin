{
  "name": "@batch.com/expo-plugin",
  "version": "1.1.0",
  "description": "Batch.com Expo Plugin",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "eslint --no-fix \"plugin/**\"",
    "lint:fail-on-warnings": "eslint \"plugin/**\" --no-fix --max-warnings 0",
    "lint:fix": "eslint --fix \"plugin/**\" || true",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:BatchLabs/Batch-Expo-Plugin.git"
  },
  "keywords": [
